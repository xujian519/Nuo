{
  "phase": 3,
  "rules": [
    {
      "id": "ui-text.localizable",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "comment": "A/C-class product self-references and the legacy data-root path. B-class rows (Osaurus Cloud/Router/ID/Identity/Secure/Premium/Connect, OsaurusAI HF org, osaurus.ai domains, plugin/config identifiers, OSAURUS_* env vars) stay untouched by design — see docs/brand/NUO-REBRAND-PLAN.md R7. Scheme A welcome copy (the two full-sentence Dino pairs) replays onto the catalog keys and their Swift literals.",
      "exclude_substrings": [
        "Osaurus Cloud",
        "Osaurus Router",
        "Osaurus ID",
        "OsaurusID",
        "Osaurus Identity",
        "Osaurus Secure",
        "Osaurus Premium",
        "Osaurus Connect",
        "OsaurusAI"
      ],
      "replace": [
        ["~/{legacy_data_root}", "~/{brand_data_root}"],
        ["{legacy_display}", "{brand_display}"],
        ["Install the `osaurus` CLI", "Install the `{brand_slug}` CLI"],
        ["osaurus tools reset", "{brand_slug} tools reset"],
        ["Grant osaurus", "Grant {brand_display}"],
        ["osaurus://themes-install", "{brand_slug}://themes-install"],
        ["com.osaurus.storage", "com.{brand_slug}.storage"],
        ["osaurus://workspaces/join", "{brand_slug}://workspaces/join"],
        ["osaurus의", "{brand_display}의"],
        ["osaurus доступ", "{brand_display} доступ"],
        ["osaurus 访问", "{brand_display} 访问"],
        ["osaurus 存取", "{brand_display} 存取"],
        [
          "A Dino for every side of your work.",
          "Local agents that keep their word."
        ],
        [
          "Build your own team of Dinos for every side of your life. Your chats, files, and keys can stay private on your Mac. No account or cloud required.",
          "Local agents on your Mac. Your chats, files, and keys can stay on this device. No account or cloud required."
        ]
      ],
      "sync_refs": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift"
      ],
      "sync_refs_exclude": [
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ]
    },
    {
      "id": "ui-text.localizable-english-articles",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": ["en"],
      "comment": "English-only: `an Osaurus ...` became `an Nuo ...` after the rename. Other languages keep their own article (German `an Nuo` means `to Nuo`).",
      "replace": [
        ["an Nuo", "a Nuo"],
        ["an nuo", "a {brand_slug}"]
      ],
      "sync_refs": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift"
      ],
      "sync_refs_exclude": [
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ]
    },
    {
      "id": "ui-text.onboarding-agent-copy",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": [
        "en"
      ],
      "comment": "Scheme A onboarding: retire the Dino metaphor in favour of 'agent', matching the already-accepted welcome headline ('Local agents that keep their word.'). The English pass drives both the catalog key renames and their Swift literal references; per-language rules below translate the same metaphor into each language's word for 'agent'.",
      "replace": [
        [
          "Set up a dino",
          "Set up an agent"
        ],
        [
          "Dino",
          "agent"
        ],
        [
          "dino",
          "agent"
        ]
      ],
      "sync_refs": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift"
      ],
      "sync_refs_exclude": [
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ]
    },
    {
      "id": "ui-text.onboarding-agent-copy-de",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": [
        "de"
      ],
      "comment": "German keeps Agent in n-declension: accusative/possessive forms take -en (deinen Agenten), nominative stays Agent.",
      "replace": [
        [
          "deinen Dino",
          "deinen Agenten"
        ],
        [
          "deinem Dino",
          "deinem Agenten"
        ],
        [
          "einen Dino",
          "einen Agenten"
        ],
        [
          "dein Dino",
          "dein Agent"
        ],
        [
          "Dino erstellen",
          "Agent erstellen"
        ],
        [
          "your dino",
          "your agent"
        ]
      ]
    },
    {
      "id": "ui-text.onboarding-agent-copy-ko",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": [
        "ko"
      ],
      "comment": "Korean particle agreement: 공룡 ends in a consonant (을/이), 에이전트 ends in a vowel (를/가).",
      "replace": [
        [
          "공룡이",
          "에이전트가"
        ],
        [
          "공룡을",
          "에이전트를"
        ],
        [
          "공룡에게",
          "에이전트에게"
        ],
        [
          "공룡",
          "에이전트"
        ],
        [
          "디노가",
          "에이전트가"
        ],
        [
          "디노의",
          "에이전트의"
        ],
        [
          "다이노가",
          "에이전트가"
        ],
        [
          "다이노의",
          "에이전트의"
        ],
        [
          "Dino 생성",
          "에이전트 생성"
        ]
      ]
    },
    {
      "id": "ui-text.onboarding-agent-copy-ru",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": [
        "ru"
      ],
      "comment": "Russian case endings survive the stem swap: динозавр->агент yields динозавра->агента, динозавру->агенту, динозавром->агентом without extra rules.",
      "replace": [
        [
          "динозавр",
          "агент"
        ],
        [
          "Создать Дино",
          "Создать агента"
        ]
      ]
    },
    {
      "id": "ui-text.onboarding-agent-copy-zh-hans",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": [
        "zh-Hans"
      ],
      "comment": "Simplified Chinese: the measure word changes with the noun (一只小恐龙 -> 一个智能体).",
      "replace": [
        [
          "一只小恐龙",
          "一个智能体"
        ],
        [
          "小恐龙",
          "智能体"
        ],
        [
          "恐龙",
          "智能体"
        ]
      ]
    },
    {
      "id": "ui-text.onboarding-agent-copy-zh-hant",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": [
        "zh-Hant"
      ],
      "comment": "Traditional Chinese: same measure-word rule as Simplified (一隻小恐龍 -> 一個智能體).",
      "replace": [
        [
          "一隻小恐龍",
          "一個智能體"
        ],
        [
          "小恐龍",
          "智能體"
        ],
        [
          "恐龍",
          "智能體"
        ]
      ]
    },
    {
      "id": "ui-text.agent-avatar-accessibility",
      "op": "replace",
      "mode": "swift-literals",
      "files": [
        "Packages/OsaurusCore/Views/Agent/AgentAvatarView.swift"
      ],
      "pattern": "\\b(Blue|Green|Orange|Purple|Red|Yellow) dino\\b",
      "replace": "\\1 agent",
      "enforced": true,
      "comment": "Scope-A follow-up: AgentMascot.displayName feeds the onboarding avatar strip's accessibility labels and tooltips. Only string literals are rewritten, so the enum cases and asset names (osaurus-avatar-*) stay untouched."
    },
    {
      "id": "ui-text.swift-literals",
      "op": "replace",
      "mode": "swift-literals",
      "files": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift",
        "Packages/OsaurusRepository/**/*.swift"
      ],
      "files_exclude": [
        "Packages/OsaurusRepository/Brand.swift",
        "Packages/OsaurusCore/Tests/Utils/AppDefaultsMigrationTests.swift",
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ],
      "exclude_substrings": [
        "Osaurus Cloud",
        "Osaurus Router",
        "Osaurus ID",
        "OsaurusID",
        "Osaurus Identity",
        "Osaurus Secure",
        "Osaurus Premium",
        "Osaurus Connect",
        "OsaurusAI",
        "Osaurus phone app",
        "Osaurus.app"
      ],
      "pattern": "\\bOsaurus\\b",
      "replace": "{brand_display}",
      "enforced": true,
      "comment": "Hardcoded brand self-references in Swift string literals: UI copy, log prefixes ([Osaurus] -> [Nuo]), tool descriptions, test fixtures. \\b protects every OsaurusXxx code identifier (OsaurusRouter, OsaurusPaths, ...); PROTECTED frozen literals (X-Osaurus-*, OSAURUS_*, ai.osaurus.*, min_osaurus, osaurus_help) are spliced out by substitute(); exclude_substrings shields B-class service names and upstream mocks per R7. AppDefaultsMigrationTests is excluded because its fixtures ARE legacy defaults keys (NSWindow Frame Osaurus Chat) that the migration under test must keep reading."
    }
  ]
}
