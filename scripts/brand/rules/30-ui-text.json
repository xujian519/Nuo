{
  "phase": 3,
  "rules": [
    {
      "id": "ui-text.localizable",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "comment": "A/C-class product self-references and the legacy data-root path. B-class rows (Osaurus Cloud/Router/ID/Identity/Secure/Premium/Connect, OsaurusAI HF org, osaurus.ai domains, plugin/config identifiers, OSAURUS_* env vars) stay untouched by design — see docs/brand/NUO-REBRAND-PLAN.md R7.",
      "exclude_substrings": [
        "Osaurus Cloud",
        "Osaurus Router",
        "Osaurus ID",
        "OsaurusID",
        "Osaurus Identity",
        "Osaurus Secure",
        "Osaurus Premium",
        "Osaurus Connect",
        "OsaurusAI"
      ],
      "replace": [
        ["~/{legacy_data_root}", "~/{brand_data_root}"],
        ["{legacy_display}", "{brand_display}"],
        ["Install the `osaurus` CLI", "Install the `{brand_slug}` CLI"],
        ["osaurus tools reset", "{brand_slug} tools reset"],
        ["Grant osaurus", "Grant {brand_display}"],
        ["osaurus://themes-install", "{brand_slug}://themes-install"],
        ["com.osaurus.storage", "com.{brand_slug}.storage"],
        ["osaurus://workspaces/join", "{brand_slug}://workspaces/join"],
        ["osaurus의", "{brand_display}의"],
        ["osaurus доступ", "{brand_display} доступ"],
        ["osaurus 访问", "{brand_display} 访问"],
        ["osaurus 存取", "{brand_display} 存取"]
      ],
      "sync_refs": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift"
      ],
      "sync_refs_exclude": [
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ]
    },
    {
      "id": "ui-text.localizable-english-articles",
      "op": "xcstrings",
      "path": "Packages/OsaurusCore/Resources/Localizable.xcstrings",
      "enforced": true,
      "languages": ["en"],
      "comment": "English-only: `an Osaurus ...` became `an Nuo ...` after the rename. Other languages keep their own article (German `an Nuo` means `to Nuo`).",
      "replace": [
        ["an Nuo", "a Nuo"],
        ["an nuo", "a {brand_slug}"]
      ],
      "sync_refs": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift"
      ],
      "sync_refs_exclude": [
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ]
    },
    {
      "id": "ui-text.swift-literals",
      "op": "replace",
      "mode": "swift-literals",
      "files": [
        "App/osaurus/**/*.swift",
        "Packages/OsaurusCore/**/*.swift",
        "Packages/OsaurusCLI/Sources/**/*.swift",
        "Packages/OsaurusRepository/**/*.swift"
      ],
      "files_exclude": [
        "Packages/OsaurusRepository/Brand.swift",
        "Packages/OsaurusCore/Tests/Utils/AppDefaultsMigrationTests.swift",
        "Packages/OsaurusCore/Services/MediaGeneration/OsaurusCloudMediaClient.swift",
        "Packages/OsaurusCore/Services/MCP/OAuth/MCPOAuthClientMetadata.swift",
        "Packages/OsaurusCore/Services/Provider/OpenRouterOAuthService.swift"
      ],
      "exclude_substrings": [
        "Osaurus Cloud",
        "Osaurus Router",
        "Osaurus ID",
        "OsaurusID",
        "Osaurus Identity",
        "Osaurus Secure",
        "Osaurus Premium",
        "Osaurus Connect",
        "OsaurusAI",
        "Osaurus phone app",
        "Osaurus.app"
      ],
      "pattern": "\\bOsaurus\\b",
      "replace": "{brand_display}",
      "enforced": true,
      "comment": "Hardcoded brand self-references in Swift string literals: UI copy, log prefixes ([Osaurus] -> [Nuo]), tool descriptions, test fixtures. \\b protects every OsaurusXxx code identifier (OsaurusRouter, OsaurusPaths, ...); PROTECTED frozen literals (X-Osaurus-*, OSAURUS_*, ai.osaurus.*, min_osaurus, osaurus_help) are spliced out by substitute(); exclude_substrings shields B-class service names and upstream mocks per R7. AppDefaultsMigrationTests is excluded because its fixtures ARE legacy defaults keys (NSWindow Frame Osaurus Chat) that the migration under test must keep reading."
    }
  ]
}
